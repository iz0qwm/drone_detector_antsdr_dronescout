        <mxCell id="mXvSlxl-P3u-fRIJCbUz-2" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="Per semplicità non ho sviluppato tutti i casi possibili di interazione tra la&lt;div&gt;struttura del CNSAS (tipicamente un TCO presso la C.O. del CNSAS o presso&lt;/div&gt;&lt;div&gt;la Sala Operativa degli Enti di Soccorso con cui ci sono convenzioni attive.&lt;br&gt;&lt;br&gt;L&#39;obiettivo di questo grafo è di evidenziare soprattutto la parte di attività&lt;/div&gt;&lt;div&gt;interne al CNSAS e funzionali alla attivazione di Equipaggi UAS con relativi UAS&lt;/div&gt;&lt;div&gt;a supporto di interventi di RICERCA con la attivazione di un CCR o CCRA.&lt;br&gt;&lt;br&gt;Dovrebbe essere rappresentativa anche in caso di attivazione di interventi di&lt;/div&gt;&lt;div&gt;ricerca di &quot;taglia inferiore&quot; che utilizzano da subito Equipaggi UAS e relativi mezzi&lt;/div&gt;&lt;div&gt;anche senza attivare CCR e/o CCRA: le condizioni di URGENZA per l&#39;inizio dei voli&lt;/div&gt;&lt;div&gt;e le condizioni che caratterizzano il tipo di volo(e quindi RISCHIO/SAFETY sono uguali&lt;/div&gt;" vertex="1">
          <mxGeometry height="186" width="480" x="-605" y="-718" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
